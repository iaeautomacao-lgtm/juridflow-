# ---------------------------------------------------------------------------
# JuridFlow - backend
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# ---------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Banco: MariaDB / MySQL.
#
# Troque `senha-forte-aqui` por uma senha propria. Se ela tiver caractere
# reservado de URL (@ / ? # [ ]), use percent-encoding: @ vira %40, # vira
# %23 - senao o Prisma le a senha cortada e a conexao falha com
# "access denied" sem dizer o motivo.
#
# Depois de preencher, crie banco e usuario com:
#   npm run banco:preparar | mysql -u root -p
#
# MariaDB nativo no Windows / Linux (porta 3306) - caminho padrao:
DATABASE_URL="mysql://juridflow:senha-forte-aqui@localhost:3306/juridflow"
#
# Docker Compose (opcional, porta 3307 para nao conflitar com um MariaDB
# ja instalado na 3306):
# DATABASE_URL="mysql://juridflow:juridflow@localhost:3307/juridflow"
#
# cPanel (usuario e banco criados no assistente do painel):
# DATABASE_URL="mysql://usuario_cpanel:senha@localhost:3306/usuario_juridflow"

# Segredo de assinatura do JWT. Minimo 32 caracteres, sem valor padrao.
# Gere um novo por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Validade do token de sessao (formato do pacote ms: 15m, 12h, 7d).
JWT_EXPIRES_IN="12h"

# Origens do frontend autorizadas, separadas por virgula.
# OBRIGATORIO quando NODE_ENV=production.
CORS_ORIGINS="http://localhost:5173"

# ---------------------------------------------------------------------------
# Integracoes oficiais do CNJ (nenhuma exige credencial do escritorio)
# ---------------------------------------------------------------------------

# Chave publica do DataJud, distribuida pelo CNJ em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=""
DATAJUD_TIMEOUT_MS=20000

DJEN_API_URL="https://comunica.pje.jus.br/api/v1/comunicacao"
DJEN_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Seed inicial (usadas apenas por `npm run seed`)
# ---------------------------------------------------------------------------

# Senha inicial da equipe. Minimo 10 caracteres. Trocar no primeiro acesso.
SEED_ADMIN_PASSWORD=""
SEED_TENANT_NOME="Escritorio JuridFlow"
SEED_TENANT_CNPJ=""
SEED_EMAIL_DOMINIO="juridflow.local"
