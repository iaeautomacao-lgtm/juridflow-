# Apache do cPanel - configuracao do frontend do JuridFlow.
#
# Este arquivo vive em frontend/public/, entao o Vite o copia para dist/ em
# todo build. Assim ele fica versionado com o codigo, em vez de ser criado a
# mao no Gerenciador de Arquivos e esquecido no proximo deploy.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deixa /api para o Passenger (a API Node).
  #
  # Sem esta linha, o catch-all da SPA logo abaixo engole as chamadas da API e
  # devolve index.html. O sintoma e confuso: o frontend recebe HTML onde
  # espera JSON e quebra com erro de parse, sem nada apontando para
  # roteamento.
  RewriteRule ^api(/|$) - [L]

  # Arquivo ou diretorio que existe e servido direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota cai no index.html, que a aplicacao resolve.
  RewriteRule . /index.html [L]
</IfModule>

# Cache: os assets levam hash no nome, entao podem ser cacheados para sempre.
# O index.html nunca - e ele que aponta para os hashes novos apos um deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Cabecalhos de seguranca.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: exige HTTPS por 1 ano. Ative apenas depois de confirmar que o
  # AutoSSL emitiu o certificado - com HTTPS quebrado, o site fica
  # inacessivel pelo periodo do max-age.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Compressao.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Nada de listar diretorio.
Options -Indexes
