# URL base da API do JuridFlow.
#
# Deixe como /api em desenvolvimento: a requisicao vai para o proxy
# configurado em vite.config.ts, que encaminha para localhost:3001.
#
# Em producao aponte para o dominio real do backend. Sem isso, o navegador do
# usuario tenta o proprio localhost e nada carrega.
#
#   producao:  VITE_API_URL="https://api.seudominio.com.br/api"
#   cPanel:    VITE_API_URL="https://seudominio.com.br/api"
VITE_API_URL="/api"

# ---------------------------------------------------------------------------
# ATENCAO - este arquivo NAO e lugar de segredo.
#
# O Vite injeta no bundle do navegador TODA variavel com prefixo VITE_. O que
# entra aqui com esse prefixo fica publico para qualquer visitante, no
# JavaScript da pagina. Sem o prefixo, nao e lido por nada - so ocupa espaco.
#
# Credencial de banco, chave de API e senha vivem em backend/.env, lidas pelo
# servidor. Nunca aqui.
# ---------------------------------------------------------------------------
